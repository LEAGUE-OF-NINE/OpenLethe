# Copy to .env and adjust. Loaded on server startup (real env vars take precedence).

# Postgres connection string (enables migrations + account/dungeon state).
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=openlethe;Username=postgres;Password=postgres

# HS256 JWT signing secret. Optional on localhost (a random ephemeral key is used if unset).
# Auth__JwtSecret=change-me-to-a-long-random-string

# Host/port to bind. Takes effect when NOT running under a launch profile (i.e. the
# published DLL, or `dotnet run --no-launch-profile`). Under `dotnet run` the launch
# profile's applicationUrl (http://localhost:5055) wins. Use 0.0.0.0 to bind all interfaces.
# ASPNETCORE_URLS=http://localhost:5055

# Environment: Development or Production. Same precedence note as ASPNETCORE_URLS — a launch
# profile sets Development, so this only applies to the published DLL / --no-launch-profile.
# ASPNETCORE_ENVIRONMENT=Development

# --- Discord OAuth (/auth/*) ------------------------------------------------
# Required for the Discord login flow. Without them /auth/discord and
# /auth/authorized 500; the rest of the server (and /auth/login dev login) is fine.
# CLIENT_ID=your-discord-application-id
# CLIENT_SECRET=your-discord-application-secret
# FRONTEND_URL=http://localhost:5173
# Where Discord sends the browser back. Must match the Developer Portal entry
# EXACTLY (scheme, host, port, path - "localhost" != "127.0.0.1") and must be the
# address YOU reach the server at: 8080 via docker compose / run.bat, 5055 under
# `dotnet run`.
# REDIRECT_URL=http://localhost:8080/auth/authorized
# AUTH_URL=https://discord.com/api/oauth2/authorize?response_type=code
# TOKEN_URL=https://discord.com/api/oauth2/token

# Membership gate. UNSET = no whitelist, anyone with a Discord account may log in.
# Set DISCORD_GUILD_ID to require membership of that server (needs a bot token);
# DISCORD_WHITELIST_IDS is a comma-separated bypass list of user snowflakes.
# DISCORD_GUILD_ID=
# DISCORD_TOKEN=
# DISCORD_WHITELIST_IDS=

# Cloudflare Turnstile secret. Only /auth/captcha needs it, which in turn is the
# only way to obtain the abuse_exemption cookie /misc/locale requires.
# CAPTCHA_SECRET_KEY=

# --- Limits (matter once the server is publicly reachable) -------------------
# The launcher-payload routes opt out of the timeout, since they stream large files.
# REQUEST_TIMEOUT_SECONDS=15
# MAX_REQUEST_BODY_BYTES=2097152

# --- Launcher payloads ------------------------------------------------------
# Directory holding the files LetheLauncher downloads from the server root:
# Lethe.dll, ModularSkillScripts.dll, motions.dll, limbus-manifest.txt,
# noticeMeta.json. Relative paths resolve against the app's content root; the
# Docker image mounts ./modfiles here. Missing files 404 with a message saying so.
# MOD_FILES_DIR=modfiles
#
# Or serve them from Discord release channels, as the upstream server does: the
# newest attachment in the channel whose filename matches wins, and the client is
# redirected to the CDN link. Needs DISCORD_TOKEN above. A local file always beats
# the channel, and a Discord outage falls back rather than failing the request.
# RELEASE_CHANNEL_ID=            # Lethe.dll (and motions.dll if the next one is unset)
# MODULAR_RELEASE_CHANNEL_ID=    # ModularSkillScripts.dll
# MOTIONS_RELEASE_CHANNEL_ID=    # motions.dll; falls back to RELEASE_CHANNEL_ID
#
# Where /limbus-manifest.txt redirects when no local file is present.
# LIMBUS_MANIFEST_URL=https://files.lethelc.site/limbus-manifest.txt

# --- Skill translation (/misc/locale) ---------------------------------------
# Any OpenAI-compatible chat-completions endpoint.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-3.5-turbo
